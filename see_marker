# camera variables and real-life measurements
field_of_view_h = 62.2 # degrees
field_of_view_v = 48.8 # degrees
focal_length = 3.04  # mm
pixel_size = 1.12   # microns
real_object_size = 10.0 #cm

distance_numerator = real_object_size * (focal_length/10) / (pixel_size/1000)  #changed from real*focal*pixel_size to real*focal/pixel_size, previous was incorrect formula

class SeeMarker(Node):
 """
 Create an ImageSubscriber class, which is a subclass of the Node class.
 """
 def __init__(self):
  """
  Class constructor to set up the node
  """
  # Initiate the Node class's constructor and give it a name
  super().__init__('see_marker')

  self.range = 0
  self.prev_h = 0
  self.prev_r = 0
  self.seen_combinations = set()
   
  # Create the subscriber. This subscriber will receive an Image
  # from the video_frames topic. The queue size is 10 messages.
  self.subscription = self.create_subscription(
   CompressedImage,
   '/camera/image_raw/compressed',  # Change to "compressed" for real robot
   self.listener_callback,
   10 
  )

  # this is for my own laptop camera testing
  # self.subscription = self.create_subscription(
  #  CompressedImage,
  #  '/image_raw/compressed',  # Change to "compressed" for real robot
  #  self.listener_callback,
  #  10 
  # )
  self.subscription # prevent unused variable warning
   
  # Used to convert between ROS and OpenCV images
  self.br = CvBridge()

  self.point_publisher = self.create_publisher(PointStamped, '/marker_position', 10)
  self.mask_publisher = self.create_publisher(Image, '/see_marker/mask', 10)

 def reset_combinations(self):
  """Reset the set of seen marker combinations"""
  self.seen_combinations.clear()


 def listener_callback(self, data):
  """
  Callback function.
  """
  #self.get_logger().info('Receiving video frame')

  # Handle both image types
  if isinstance(data, CompressedImage):
   np_arr = np.frombuffer(data.data, np.uint8)
   current_frame = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)
  else:  # sensor_msgs/msg/Image
   current_frame = self.br.imgmsg_to_cv2(data, desired_encoding='bgr8')

  if current_frame is None:
   self.get_logger().warn("Failed to convert image")
   return


  # The following code is a simple example of colour segmentation
  # and connected components analysis
  
  # Convert BGR image to HSV
  hsv_frame = cv2.cvtColor(current_frame, cv2.COLOR_BGR2HSV)

  # Find pink blob
  pink_blob = segment(current_frame, hsv_frame, "pink")
  if pink_blob:
   (pink_x, pink_y, pink_h, p_d, p_a) = pink_blob

   for c in ["blue", "green", "yellow"]:
    blob = segment(current_frame, hsv_frame, c)
    if blob:
     (c_x, c_y, c_h, c_d, c_a) = blob

     # Check to see if the blobs are verically aligned
     if abs(pink_x - c_x) > pink_h:
#      print(f'pink_x = {pink_x}, pink_y = {pink_y}, h = {pink_h}')
      continue

     marker_at = PointStamped()
     marker_at.header.stamp = self.get_clock().now().to_msg()
     marker_at.header.frame_id = 'camera_link'

     """
     The next few lines are a hack. Since the markers are always on the ground,
     we don't use the "z" coordinate for position, so instead we use it to
     store the parker type. Ugly, but it saves creating a new message type.
     """
     # Determine the combination
     combination = c + '/pink' if c_y < pink_y else 'pink/' + c
     
     # Only proceed if we haven't seen this combination before
     if combination not in self.seen_combinations:
      if c_y < pink_y: # +y is down
       print(c, "/ pink", f'{c_d:.2f}, {c_a:.2f}')
       marker_at.point.z = float(marker_type.index(combination))
      else:
       print("pink / ", c, f'{p_d:.2f}, {p_a:.2f}')
       marker_at.point.z = float(marker_type.index(combination))
      
      x, y = polar_to_cartesian(c_d, c_a)
      marker_at.point.x = x
      marker_at.point.y = y
      
      # Add the combination to our seen set
      self.seen_combinations.add(combination)

     # print(f'Camera coordinates: {x}, {y}')
     self.point_publisher.publish(marker_at)
     self.get_logger().info('Published Point: x=%f, y=%f, z=%f' %
      (marker_at.point.x, marker_at.point.y, marker_at.point.z))
     # print('Published Point: x=%f, y=%f, z=%f' %
     #  (marker_at.point.x, marker_at.point.y, marker_at.point.z))
  else:
   print("No marker found")

  # Display camera image
  cv2.imshow("camera", current_frame) 
  cv2.waitKey(1)


colours = {
 "pink":   ((140,65,0), (160, 220, 255)),
 "blue":  ((110,65,0), (130, 200, 255)),
 "green": ((40,60,0), (90, 255, 255)),
 "yellow": ((25,65,0), (32, 220, 255))
}


